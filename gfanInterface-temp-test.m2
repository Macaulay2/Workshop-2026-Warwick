restart
needsPackage("gfanInterface", Configuration=>{"keepfiles"=>true,"verbose"=>true})
QQ[x,y]
gfanTropicalPrevariety {x+y, x+y+1} 
-*
_application PolyhedralFan
_version 2.2
_type PolyhedralFan

AMBIENT_DIM
2

LINEALITY_DIM
0

RAYS
1 1	# 0

N_RAYS
1

LINEALITY_SPACE

ORTH_LINEALITY_SPACE
-1 0	# 0
0 -1	# 1

F_VECTOR
1 1

CONES
{}	# Dimension 0
{0}	# Dimension 1

MAXIMAL_CONES_OF_CLOSURE
{0}	# Dimension 1 
*-

gfanTropicalIntersection {x+y, x+y+1} 
-*
_application fan
_version 2.2
_type SymmetricFan

AMBIENT_DIM
2

DIM
1

LINEALITY_DIM
0

RAYS
1 1	# 0

N_RAYS
1

LINEALITY_SPACE

ORTH_LINEALITY_SPACE
1 0
0 1

F_VECTOR
1 1

SIMPLICIAL
1

PURE
1

CONES
{}	# Dimension 0
{0}	# Dimension 1

MAXIMAL_CONES
{0}	# Dimension 1

MULTIPLICITIES
1	# Dimension 1
*-

